{
  "name": "Shotframe",
  "short_name": "Shotframe",
  "description": "Beautify screenshots with backgrounds, frames, shadows and annotations.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#131314",
  "theme_color": "#131314",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"]
      }
    }
  ]
}
